# <<<

# >>> API and UI server configuration
API_SERVER_HOST=localhost
API_PUBLISHED_PORT=6868
API_INTERNAL_PORT=8080
API_PROTOCOL=http

UI_SERVER_HOST=localhost
UI_PUBLISHED_PORT=3000
UI_INTERNAL_PORT=80
UI_PROTOCOL=http

# UI origin for API CORS configuration
UI_ORIGIN="${UI_PROTOCOL}://${UI_SERVER_HOST}:${UI_PUBLISHED_PORT}"
# API origin for UI axios configuration
API_ORIGIN="${API_PROTOCOL}://${API_SERVER_HOST}:${API_PUBLISHED_PORT}"
# <<<

