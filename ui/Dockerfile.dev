ARG NODE_VERSION=lts-alpine3.19

FROM node:${NODE_VERSION} AS dependencies

WORKDIR /ui

RUN chown -R node:node /ui

USER node

COPY --chown=node:node package*.json ./
RUN npm install

FROM dependencies AS dev

WORKDIR /ui

USER node

COPY --chown=node:node . .

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
